# Zoho HR Suite MCP — Optional Environment Variables
# Note: You do NOT need to edit this file manually!
# You can simply link your Zoho account directly inside Antigravity/Claude chat
# using the `zoho_auth_configure` tool, or by running `npm run setup`.

# Zoho Data Center Region: com | in | eu | com.au | jp | ca | sa
ZOHO_REGION=in

# Zoho OAuth 2.0 Self-Client Credentials (from https://api-console.zoho.com/)
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=

# Zoho Books Organization ID (Auto-discovered if left blank)
ZOHO_BOOKS_ORG_ID=

# Optional Company Branding for Dynamic DOCX/PDF Document Generation
COMPANY_NAME=Your Company Name
COMPANY_ADDRESS=
COMPANY_EMAIL=
COMPANY_PHONE=
